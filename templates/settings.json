{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(npx *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-report.sh",
            "timeout": 15,
            "statusMessage": "Checking knowledge base status..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-hardcoded-values.sh",
            "timeout": 10,
            "statusMessage": "Checking for hardcoded values..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-duplicate-component.sh",
            "timeout": 10,
            "statusMessage": "Checking for duplicate components..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-e2e-test-exists.sh",
            "timeout": 10,
            "statusMessage": "Checking e2e test coverage..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-vault-baseline.sh",
            "timeout": 5,
            "statusMessage": "Checking vault protection..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-quality.sh",
            "timeout": 120,
            "async": true,
            "statusMessage": "Running quality checks..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-story-exists.sh",
            "timeout": 10,
            "statusMessage": "Checking Storybook coverage..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-a11y.sh",
            "timeout": 10,
            "async": true,
            "statusMessage": "Checking accessibility coverage..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/report-recovery.sh",
            "timeout": 10,
            "async": true,
            "statusMessage": "Reporting design token fixes..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-kb-drift.sh",
            "timeout": 10,
            "async": true,
            "statusMessage": "Checking knowledge base drift..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-mermaid-validity.sh",
            "timeout": 10,
            "statusMessage": "Validating Mermaid diagrams..."
          }
        ]
      }
    ]
  },
  "plugins": [
    "obra/superpowers"
  ]
}
